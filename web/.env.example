# ─── Backend API ─────────────────────────────────────────────────────────────
# URL of your NestJS backend (no trailing slash)
NEXT_PUBLIC_API_BASE_URL=https://trilink-backend-ms68.onrender.com

# ─── AI Core ─────────────────────────────────────────────────────────────────
# URL of your AI Core service
NEXT_PUBLIC_AI_CORE_URL=https://trilink-ai-core-383699571084.us-central1.run.app

# Internal API key for AI Core
NEXT_PUBLIC_AI_INTERNAL_KEY=trilink-internal-change-me

# ─── Frontend URL ─────────────────────────────────────────────────────────────
# Your Vercel deployment URL (used in email links). Set this AFTER first deploy.
NEXT_PUBLIC_FRONTEND_URL=https://your-project.vercel.app

# ─── SMTP / Email (server-side only — do NOT prefix with NEXT_PUBLIC_) ───────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
# Optional: override the "From" display name/address
SMTP_FROM="TriLink School System <your-email@gmail.com>"
